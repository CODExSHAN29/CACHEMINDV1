# ==============================================================================
# CacheMind Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Logging
# ------------------------------------------------------------------------------
# Choices: "development", "production", "test", "verification"
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Master Admin Key & Security
# ------------------------------------------------------------------------------
# Required in production: must be cryptographically secure random string >= 32 chars
ADMIN_MASTER_KEY=
ALLOW_MOCK_PROVIDERS=true
ALLOW_MOCK_EMBEDDINGS=true

# ------------------------------------------------------------------------------
# Relational Database Configuration
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./cachemind.db

# Production Deployment (PostgreSQL + asyncpg):
# DATABASE_URL=postgresql+asyncpg://cachemind_user:cachemind_password@postgres:5432/cachemind_db

# Connection Pool Settings (PostgreSQL / asyncpg)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false
AUTO_RUN_MIGRATIONS=false

# ------------------------------------------------------------------------------
# Cache Backend Configuration (L1 Exact Hash Cache)
# ------------------------------------------------------------------------------
# Choices: "memory" (dev/test), "redis" (multi-instance production)
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=2.0
DEFAULT_CACHE_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# Vector Storage Backend (L2 Semantic Cache)
# ------------------------------------------------------------------------------
# Choices: "memory" (dev/test), "pgvector" (production), "qdrant"
SEMANTIC_CACHE_MODE=safe
VECTOR_BACKEND=memory
VECTOR_DIMENSION=384
VECTOR_SIMILARITY_THRESHOLD=0.92
PGVECTOR_INDEX_TYPE=hnsw

# ------------------------------------------------------------------------------
# Upstream LLM Provider Credentials & Endpoints
# ------------------------------------------------------------------------------
# Upstream OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Upstream Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Upstream Local Ollama (e.g. for private / on-prem models)
OLLAMA_BASE_URL=http://localhost:11434

# Upstream Connection Pool & Timeout Settings
UPSTREAM_TIMEOUT_SECONDS=30.0
UPSTREAM_MAX_CONNECTIONS=100
UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=20

# ------------------------------------------------------------------------------
# Resilience & Circuit Breaking
# ------------------------------------------------------------------------------
# Circuit Breaker thresholds
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30.0

# ------------------------------------------------------------------------------
# Multi-Tenant Rate Limiting (Sliding Window RPM & TPM)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
DEFAULT_RPM_LIMIT=120
DEFAULT_TPM_LIMIT=100000

# ------------------------------------------------------------------------------
# PII Masking & Privacy Sanitization
# ------------------------------------------------------------------------------
PII_MASKING_ENABLED=true
PII_MASKING_MODE=mask

# ------------------------------------------------------------------------------
# Development Fixtures (Ignored when ENVIRONMENT=production)
# ------------------------------------------------------------------------------
DEV_TENANT_ID=tenant_default
DEV_PROJECT_ID=proj_default
DEV_API_KEY=cm_live_development_test_key_000000000000000000000000
